[Unit]
Description=Ouroboros Self-Creating Agent
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/ouroboros
Environment="PATH=/home/admin/.local/share/mise/shims:/home/admin/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/admin/ouroboros/.env
ExecStart=/home/admin/.local/bin/mise exec -- python3 vps_launcher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
